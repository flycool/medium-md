{
  "manifest_version": 3,
  "name": "medium_blog_to_md",
  "description": "medium blog to md",
  "version": "2.0.1",
  "action": {},
  "permissions": ["activeTab", "scripting"],
  "web_accessible_resources": [
    {
      "resources": ["modules/*.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+B"
      }
    }
  },
  "icons": {
    "16": "blog.png",
    "32": "blog.png",
    "48": "blog.png"
  }
}
